<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nordic_bg">

    <!-- Top App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My-Assignments"
                android:textColor="#1B262C"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Nordic Flipcard Note Taking Pad"
                android:textColor="#52796F"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- + New Card Action Button -->
        <LinearLayout
            android:id="@+id/btnAddNewAssignment"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_nordic_primary"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_add"
                app:tint="@color/white"
                android:contentDescription="Add card" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="New Card"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Category / Filter Chips Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_filter_selected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All Cards"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterDueSoon"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_filter_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="⏰ Due Soon"
                android:textColor="#2F3E46"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterActive"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_filter_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="⚡ In Progress"
                android:textColor="#2F3E46"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterPriority"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_filter_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🔥 High Priority"
                android:textColor="#2F3E46"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipFilterCompleted"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_filter_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="✓ Completed"
                android:textColor="#2F3E46"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Flipcard Deck Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The Horizontal Swipeable Pad ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerCards"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyDeck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_focus_zen"
                app:tint="#52796F"
                android:contentDescription="No assignments" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="All Clear on Your Deck"
                android:textColor="#1B262C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="No assignment cards found in this view. Enjoy the peaceful Nordic calm or create a new card."
                android:textColor="#6C7A89"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/btnEmptyCreateCard"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_nordic_primary"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="+ Create Assignment Card"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Carousel Deck Controls & Card Counter -->
    <LinearLayout
        android:id="@+id/layoutBottomDeckControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:background="#EFF3F0">

        <!-- Previous Card Chevron -->
        <ImageView
            android:id="@+id/btnPrevCard"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="@drawable/bg_chip_pill"
            android:src="@drawable/ic_arrow_back"
            app:tint="#2F3E46"
            android:contentDescription="Previous Card" />

        <!-- Counter & Gesture Swipe Hint -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCardDeckCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card 1 of 5"
                android:textColor="#2F3E46"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Swipe left / right or tap to flip"
                android:textColor="#6C7A89"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Next Card Chevron -->
        <ImageView
            android:id="@+id/btnNextCard"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="@drawable/bg_chip_pill"
            android:src="@drawable/ic_arrow_forward"
            app:tint="#2F3E46"
            android:contentDescription="Next Card" />
    </LinearLayout>
</LinearLayout>
