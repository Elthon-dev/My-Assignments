<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- The 3D Flippable Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:cardMaxElevation="8dp"
        app:cardBackgroundColor="#141414">

        <!-- ================= CARD FRONT: OVERVIEW ================= -->
        <LinearLayout
            android:id="@+id/layoutCardFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_nordic_card"
            android:visibility="visible">

            <!-- Subject Accent Banner / Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="10dp">

                <!-- Subject Pill -->
                <TextView
                    android:id="@+id/tvSubjectTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_chip_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.04" />

                <!-- Priority Chip -->
                <TextView
                    android:id="@+id/tvPriorityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="HIGH"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_chip_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Status Checkmark / Button -->
                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IN PROGRESS"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_chip_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- More Options Menu -->
                <ImageView
                    android:id="@+id/btnCardOptions"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_more"
                    app:tint="#8E8E93"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More Options" />
            </LinearLayout>

            <!-- Card Content Scrollable Body -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:paddingHorizontal="18dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvAssignmentTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Assignment Title"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp" />

                    <!-- Due Date Chip & Metrics Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#8E8E93"
                            android:contentDescription="Due Date" />

                        <TextView
                            android:id="@+id/tvDueDateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Due soon"
                            android:textColor="#E5E5EA"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  •  "
                            android:textColor="#3A3A3C" />

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_clock"
                            app:tint="#8E8E93"
                            android:contentDescription="Estimated time" />

                        <TextView
                            android:id="@+id/tvEstimatedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="2.0 hrs"
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  •  "
                            android:textColor="#3A3A3C" />

                        <TextView
                            android:id="@+id/tvGradeWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15% Grade"
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Focus Study Tracker Banner -->
                    <LinearLayout
                        android:id="@+id/layoutFocusBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_chip_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:layout_marginTop="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_focus_zen"
                            app:tint="#FFFFFF"
                            android:contentDescription="Focus Mode" />

                        <TextView
                            android:id="@+id/tvFocusTimeSpent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Ready for focus sprint"
                            android:textColor="#E5E5EA"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="START"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <!-- Milestone Progress Bar & Ratio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHECKLIST PROGRESS"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvTaskProgressRatio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 0 (0%)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbTaskProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_progress_bar" />

                    <!-- Scratchpad / Notes Preview Strip -->
                    <LinearLayout
                        android:id="@+id/layoutNotesPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_notepad_paper"
                        android:padding="12dp"
                        android:layout_marginTop="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_notes"
                                app:tint="#FFFFFF"
                                android:contentDescription="Notes" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="NOTES &amp; REFERENCE SCRATCHPAD"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_flip"
                                app:tint="#8E8E93"
                                android:contentDescription="Flip" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNotesPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:text="Tap to flip card &amp; jot down lecture notes, key milestones, or scratch thoughts..."
                            android:textColor="#A1A1AA"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="• Double tap to complete • Swipe to cycle stack •"
                        android:textColor="#52525B"
                        android:textSize="10sp"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </ScrollView>

            <!-- Bottom Card Action Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp">

                <!-- Flip to Notes Pad Button -->
                <LinearLayout
                    android:id="@+id/btnFlipToBack"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_button_nordic_outline"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_flip"
                        app:tint="#FFFFFF"
                        android:contentDescription="Flip" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Notes &amp; Tasks"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Zen Focus Button -->
                <LinearLayout
                    android:id="@+id/btnZenFocusMode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_nordic_primary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_focus_zen"
                        app:tint="#000000"
                        android:contentDescription="Zen Focus" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Zen Focus"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= CARD BACK: THE NOTE TAKING PAD ================= -->
        <LinearLayout
            android:id="@+id/layoutCardBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_nordic_card_back"
            android:visibility="gone">

            <!-- Back Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:background="#161616">

                <!-- Flip Back Button -->
                <LinearLayout
                    android:id="@+id/btnFlipToFront"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip_pill"
                    android:paddingHorizontal="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_flip"
                        app:tint="#FFFFFF"
                        android:contentDescription="Flip back" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Card"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBackSubjectTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:text="Notes &amp; Milestones"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Copy / Share Notes -->
                <ImageView
                    android:id="@+id/btnCopyNotes"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_share"
                    app:tint="#8E8E93"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Share notes" />

                <!-- Save Notes / Finish Edit Checkmark -->
                <ImageView
                    android:id="@+id/btnSaveNotes"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_check"
                    app:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Save &amp; Return" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#262626" />

            <!-- Scrollable Notepad & Checklist Area -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Ruled Note Pad Area -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOTES &amp; REFERENCE PAD"
                        android:textColor="#8E8E93"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:letterSpacing="0.08" />

                    <EditText
                        android:id="@+id/etAssignmentNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="10"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_notepad_paper"
                        android:gravity="top|start"
                        android:hint="Jot down notes, lecture formulas, essay points, professor tips..."
                        android:padding="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#52525B"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                    <!-- Checklist / Subtasks Section Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="MILESTONE CHECKLIST"
                        android:textColor="#8E8E93"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:letterSpacing="0.08" />

                    <!-- Quick Add Subtask Input Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <EditText
                            android:id="@+id/etNewSubTask"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_notepad_paper"
                            android:hint="+ Add sub-task or milestone..."
                            android:textColorHint="#52525B"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:paddingHorizontal="10dp"
                            android:singleLine="true" />

                        <ImageView
                            android:id="@+id/btnAddSubTask"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_button_nordic_outline"
                            android:padding="8dp"
                            android:src="@drawable/ic_add"
                            app:tint="#FFFFFF"
                            android:contentDescription="Add sub task" />
                    </LinearLayout>

                    <!-- Subtasks List Container -->
                    <LinearLayout
                        android:id="@+id/layoutSubTasksContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />
                </LinearLayout>
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#262626" />

            <!-- Bottom Action for Note Pad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:background="#161616">

                <TextView
                    android:id="@+id/btnQuickFocusFromNotes"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_nordic_outline"
                    android:gravity="center"
                    android:text="Focus On This Assignment"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Completion Burst Overlay -->
        <FrameLayout
            android:id="@+id/layoutCompletionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60A0A0A"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivCompletionCheck"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_chip_pill"
                    android:padding="16dp"
                    android:src="@drawable/ic_check"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="COMPLETED"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Removed from active stack"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

    </androidx.cardview.widget.CardView>
</FrameLayout>
